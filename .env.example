# LeetCode Classroom Dashboard Environment Variables

# PostgreSQL Database Connection URL (for Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/leetcode_classroom?schema=public"

# JWT Secret for signing session tokens
JWT_SECRET="leetcode-classroom-dashboard-secret-key-42"

# Port for local server execution (default: 3000)
PORT=3000

# Base URL for public LeetCode API proxy
LEETCODE_API_BASE="https://alfa-leetcode-api.onrender.com"

# Gemini API Key (if AI Studio / Gemini API features are used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP URL (Injected automatically at runtime on Cloud Run)
APP_URL="http://localhost:3000"
